# ============================================
# Настройки подключения к базе данных
# ============================================
# Хост базы данных
DB_HOST=localhost
# Имя базы данных
DB_NAME=mydatabase
# Пользователь базы данных
DB_USER=myuser
# Пароль пользователя
DB_PASSWORD=mypassword

# ============================================
# Настройки SOAP сервиса (1С)
# ============================================
# URL SOAP сервиса 1С
ONEC_SERVICE_URL=http://server-iis/unf/ws/AIWebServices?wsdl
# Таймаут SOAP запросов в секундах
SOAP_TIMEOUT=30

# ============================================
# Настройки логирования
# ============================================
# Уровень логирования (DEBUG, INFO, WARNING, ERROR, CRITICAL)
LOG_LEVEL=INFO

# ============================================
# Настройки SMB (сетевые папки Windows)
# ============================================
# Сервер SMB
SMB_SERVER=server-sql
# Имя пользователя SMB
SMB_USERNAME=user1
# Пароль SMB
SMB_PASSWORD=pass1
# Имя сетевой папки (шары)
SMB_SHARE=UNF_Share
# Порт SMB
SMB_PORT=445

# ============================================
# Настройки MLflow
# ============================================
# URI для отслеживания экспериментов MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000

# ============================================
# Настройки Airflow (если используется)
# ============================================
# Дата начала загрузки данных (формат: YYYY-MM-DD)
LOAD_START_DATE=2023-01-01
# Дата окончания загрузки данных (формат: YYYY-MM-DD)
LOAD_END_DATE=2027-01-01