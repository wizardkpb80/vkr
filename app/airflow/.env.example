# Создайте файл .env на основе этого шаблона

# Database Configuration
DB_HOST=localhost
DB_NAME=mydatabase
DB_USER=myuser
DB_PASSWORD=mypassword

# Qwen Model Configuration
QWEN_OUT_DIR=/tmp/qwen_model
QWEN_IMAGE_DIR=/tmp/images
USE_SMB=true
QWEN_MODEL_NAME=Qwen/Qwen2.5-VL-3B-Instruct
QWEN_BATCH_SIZE=1
QWEN_EPOCHS=3
QWEN_LEARNING_RATE=0.0002

# Baseline Model Configuration
BASELINE_MODEL_PATH=/tmp/baseline_model.pkl
BASELINE_N_ESTIMATORS=100
BASELINE_TEST_SIZE=0.2

# SMB Configuration
SMB_SERVER=server-sql
SMB_USERNAME=user1
SMB_PASSWORD=pass1
SMB_SHARE=UNF_Share
SMB_PORT=445

# GPU Configuration
USE_GPU=true
TORCH_DTYPE=float16

# Data Filters
RESOURCE_FILTER=Датрон|ПЛ
MATERIAL_FILTER=Латунь|Алюминий|Стеклотекстолит
MIN_DURATION_MINUTES=1
MAX_DURATION_MINUTES=1440